JoinView
  base tables: Items, Owners
  primary key: OwnerID, ItemID
JoinedToSubqueryView
  base tables: Items, ArchivedItems
  primary key: OwnerID, ItemID
NestedView
  base tables: PlainView
  primary key: OwnerID, ItemID
OrderedView
  base tables: Items
  primary key: OwnerID, ItemID
PlainView
  base tables: Items
  primary key: OwnerID, ItemID
SubqueryFirstView
